# /etc/hufu/hufu.env on the VM (root-only, mode 600). Not secret settings.
# The inference key goes in /etc/hufu/secrets.env as VULTR_INFERENCE_API_KEY=..., never in git.

# The model on Vultr Serverless Inference. Tool calling is required.
VULTR_MODEL=glm-5.3
# HTTPS address of this server. setup.sh fills it in with <ip>.sslip.io.
HUFU_PUBLIC_URL=https://0-0-0-0.sslip.io
# Shown in the page header.
HUFU_HOST_LABEL=Vultr Cloud Compute · Seattle
# Sandboxes run under gVisor on the VM.
HUFU_SANDBOX_RUNTIME=runsc
# A public demo must not drain the inference credits.
HUFU_LIVE_RUNS_PER_HOUR=30
HUFU_RUNS_PER_VISITOR=12
